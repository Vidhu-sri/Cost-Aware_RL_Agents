# Copy to config.env and fill in. Paths may be relative to this package dir.

# --- environments (commands that activate them) ---
HARNESS_ACTIVATE="source $(conda info --base)/etc/profile.d/conda.sh && conda activate harness"
TRAIN_ACTIVATE="source $(conda info --base)/etc/profile.d/conda.sh && conda activate train"

# --- models ---
TRAIN_MODEL=/path/to/gemma-4-31b-it          # bf16 HF checkpoint used for QLoRA training
SERVE_MODEL=/path/to/gemma-4-31b-it-qat-w4a16-ct  # checkpoint vLLM serves (adapter check)

# --- data you already have ---
KAGGLE_TASKS=../data/tasks.jsonl
BASE_SUB=../submissions/base                   # the submission dir your A0 runs used
RUNS_A0="../results/a0"                        # existing Kaggle A0 results dir(s), space separated
RUNS_TRAIN="../results/swerebench"             # existing SWE-rebench results dir(s), space separated

# --- how to run swegemma: the same command you used for A0, with {SUB} and {OUT} ---
EVAL_CMD='swegemma eval --tasks ../data/tasks.jsonl --snapshots-dir ../data/snapshots --submission-dir {SUB} --results-dir {OUT} --sandbox subprocess --concurrency 8'
# same, but on the SWE-rebench training tasks (used only if COLLECT=1)
TRAIN_RUN_CMD='swegemma eval --tasks /path/to/swerebench_tasks.jsonl --snapshots-dir /path/to/swerebench_snapshots --submission-dir {SUB} --results-dir {OUT} --sandbox subprocess --concurrency 8'

# --- vLLM: leave both empty if swegemma starts vLLM itself ---
# If you run vLLM yourself, give the start command with {LORA_ARGS}; it is replaced with
# "--enable-lora --max-lora-rank 128 --lora-modules costlora=<adapter>" for adapter arms.
VLLM_START_CMD=""
VLLM_STOP_CMD=""                               # e.g. pkill -u $USER -f "vllm serve"
VLLM_URL=http://127.0.0.1:8000/v1/models

# --- extra rollouts before training (more groups + RLCD pairs) ---
COLLECT=1            # 0 = train only on what exists
COLLECT_SEEDS=2      # extra base runs per training task at temperature 0.7
COLLECT_RLCD=1       # one p+ and one p- run per training task

# extra flags for every training run, e.g. "--lr 1e-5" or "--load bf16" (bf16 needs ~70 GB)
TRAIN_EXTRA_ARGS=""

# --- thresholds: below these an arm is skipped and the reason recorded ---
MIN_SFT=5
MIN_GROUPS=8
MIN_PAIRS=8
